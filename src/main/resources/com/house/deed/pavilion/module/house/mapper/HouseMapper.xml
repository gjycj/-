<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.house.deed.pavilion.module.house.mapper.HouseMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.house.deed.pavilion.module.house.entity.House">
        <id column="id" property="id" />
        <result column="tenant_id" property="tenantId" />
        <result column="building_id" property="buildingId" />
        <result column="house_no" property="houseNo" />
        <result column="house_type" property="houseType" />
        <result column="area" property="area" />
        <result column="inside_area" property="insideArea" />
        <result column="floor" property="floor" />
        <result column="total_floor" property="totalFloor" />
        <result column="orientation" property="orientation" />
        <result column="decoration" property="decoration" />
        <result column="property_right" property="propertyRight" />
        <result column="property_right_cert_no" property="propertyRightCertNo" />
        <result column="property_right_years" property="propertyRightYears" />
        <result column="mortgage_status" property="mortgageStatus" />
        <result column="mortgage_details" property="mortgageDetails" />
        <result column="price" property="price" />
        <result column="transaction_type" property="transactionType" />
        <result column="status" property="status" />
        <result column="description" property="description" />
        <result column="create_agent_id" property="createAgentId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 定义包含关联数据的ResultMap -->
    <resultMap id="HouseWithRelationsResultMap" type="com.house.deed.pavilion.module.house.entity.House" extends="BaseResultMap">
        <!-- 关联房东信息 -->
        <collection property="landlords" ofType="com.house.deed.pavilion.module.houseLandlord.entity.HouseLandlord"
                    select="com.house.deed.pavilion.module.houseLandlord.mapper.HouseLandlordMapper.getByHouseId"
                    column="id"/>

        <!-- 关联标签信息 -->
        <collection property="tags" ofType="com.house.deed.pavilion.module.houseTag.entity.HouseTag"
                    select="com.house.deed.pavilion.module.houseTag.mapper.HouseTagMapper.getByHouseId"
                    column="id"/>
    </resultMap>

    <!-- 添加 selectHousePage 对应的 SQL 语句 -->
    <select id="selectHousePage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM house
        WHERE tenant_id = #{tenantId}
        <!-- 房号模糊查询（若 houseNo 不为空） -->
        <if test="houseNo != null and houseNo != ''">
            AND house_no LIKE CONCAT('%', #{houseNo}, '%')
        </if>
        <!-- 状态精确匹配（若 status 不为空） -->
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <!-- MyBatis-Plus 会自动拼接分页参数（LIMIT/OFFSET 等） -->
    </select>

    <!-- 修改getHousePage查询，适配HouseQueryDTO参数 -->
    <select id="getHousePage" resultMap="HouseWithRelationsResultMap">
        SELECT h.* FROM house h
        WHERE h.tenant_id = #{queryDTO.tenantId}  <!-- 实际由代码层传入tenantId，此处仅为示例 -->
        <if test="queryDTO.houseNo != null and queryDTO.houseNo != ''">
            AND h.house_no LIKE CONCAT('%', #{queryDTO.houseNo}, '%')
        </if>
        <if test="queryDTO.status != null and queryDTO.status != ''">
            AND h.status = #{queryDTO.status}
        </if>
        <if test="queryDTO.transactionType != null and queryDTO.transactionType != ''">
            AND h.transaction_type = #{queryDTO.transactionType}
        </if>
        LIMIT #{page.offset}, #{page.size}
    </select>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, tenant_id, building_id, house_no, house_type, area, inside_area, floor, total_floor, orientation, decoration, property_right, property_right_cert_no, property_right_years, mortgage_status, mortgage_details, price, transaction_type, status, description, create_agent_id, create_time, update_time
    </sql>

    <!-- 错误示例：SQL中使用了tenantId，但未传入参数 -->
    <select id="checkHouseNoUnique" resultType="java.lang.Integer">
        select count(1) from house
        where building_id = #{buildingId}
        and house_no = #{houseNo}
        and tenant_id = #{tenantId}  <!-- 此处需要tenantId参数 -->
    </select>

</mapper>
